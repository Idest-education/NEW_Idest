# PostgreSQL
DATABASE_URL=postgresql://idest:idest@localhost:5433/idest_clerk

# RabbitMQ (CloudAMQP or local amqp://)
RABBITMQ_URL=amqps://kaolxove:88P3Fcg7q2q3mzVNTa1bqwz4lAC0mBua@armadillo.rmq.cloudamqp.com/kaolxove

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Cloudinary (Task 1 chart/graph/diagram image uploads)
# dotenv does not expand ${...} references, so CLOUDINARY_URL must be the
# literal string from Console > Settings > API Keys, not built from the two
# vars below. Either set this URL, or set the three CLOUDINARY_* vars below —
# not a URL built out of them.
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
# Alternative to CLOUDINARY_URL: set these three directly instead.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Clerk (from the Clerk dashboard)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Origins / URLs
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Clerk hosted route paths
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

MIN_SECONDS_BETWEEN_CALLS=6.0
RETRY_BASE_SECONDS=2.0
RETRY_MAX_SECONDS=60.0