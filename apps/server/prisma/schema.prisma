generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  teacher
  admin
}

enum UserStatus {
  active
  suspended
  deleted
}

enum ClassStatus {
  active
  archived
}

enum RedoStatus {
  open
  resolved
  cancelled
}

enum AssignmentStatus {
  draft
  active
  closed
  archived
}

enum TaskType {
  task_1
  task_2
}

enum SubmissionStatus {
  submitted
  queued
  scoring
  scored
  under_review
  published
  failed
  abuse
}

enum ScorerType {
  ai
  teacher
}

enum ScoringStatus {
  completed
  failed
}

/// Why a teacher changed the AI's score. Drives the LLM failure-mode analysis.
enum RevisionReason {
  ai_too_generous
  ai_too_harsh
  ai_missed_off_topic
  ai_wrong_criterion
  ai_feedback_inaccurate
  ai_unavailable
  minor_polish
  other
}

/// Whether the reason was given while grading, or later in a batch.
enum ReasonSource {
  inline
  batch
}

enum ModelStatus {
  experimental
  active
  retired
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  clerkUserId     String     @unique @map("clerk_user_id")
  email           String     @unique
  displayName     String     @map("display_name")
  role            Role
  status          UserStatus @default(active)
  invitedByUserId String?    @map("invited_by_user_id") @db.Uuid
  invitedBy       User?      @relation("Invitations", fields: [invitedByUserId], references: [id])
  invitees        User[]     @relation("Invitations")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)
  /// When the teacher hid the onboarding checklist; null while it should show.
  onboardingDismissedAt DateTime? @map("onboarding_dismissed_at") @db.Timestamptz(6)

  // Relations
  assignments      Assignment[]      @relation("TeacherAssignments")
  classes          Class[]           @relation("TeacherClasses")
  classMemberships ClassMember[]     @relation("StudentClassMemberships")
  inviteLinks      InviteLink[]      @relation("TeacherInviteLinks")
  redoRequests     RedoRequest[]     @relation("TeacherRedoRequests")
  submissions      Submission[]      @relation("StudentSubmissions")
  scoringResults   ScoringResult[]   @relation("TeacherScoringResults")
  scoreRevisions   ScoreRevision[]   @relation("TeacherScoreRevisions")
  publishedResults PublishedResult[] @relation("TeacherPublishedResults")
  auditEvents      AuditEvent[]      @relation("ActorAuditEvents")
  reasonTags       RevisionReasonTag[] @relation("TeacherReasonTags")

  @@map("users")
}

model Assignment {
  id                String           @id @default(uuid()) @db.Uuid
  teacherId         String           @map("teacher_id") @db.Uuid
  teacher           User             @relation("TeacherAssignments", fields: [teacherId], references: [id])
  classId           String?          @map("class_id") @db.Uuid
  class             Class?           @relation(fields: [classId], references: [id])
  title             String           @db.VarChar(255)
  taskPrompt        String           @map("task_prompt") @db.Text
  taskType          TaskType         @map("task_type")
  /// Task 1 prompts are illustrated by a chart/graph/diagram the student must describe.
  taskImageUrl      String?          @map("task_image_url") @db.Text
  taskImagePublicId String?          @map("task_image_public_id") @db.VarChar(255)
  status            AssignmentStatus @default(draft)
  /// One assignment per teacher may be pinned to the top of the student's page.
  highlighted       Boolean          @default(false)
  dueAt             DateTime?        @map("due_at") @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?        @map("deleted_at") @db.Timestamptz(6)

  submissions Submission[]

  @@index([teacherId], map: "assignments_teacher_id_index")
  @@index([classId], map: "assignments_class_id_index")
  @@index([status], map: "assignments_status_index")
  @@index([dueAt], map: "assignments_due_at_index")
  @@index([highlighted], map: "assignments_highlighted_index")
  @@map("assignments")
}

model Submission {
  id             String           @id @default(uuid()) @db.Uuid
  assignmentId   String           @map("assignment_id") @db.Uuid
  assignment     Assignment       @relation(fields: [assignmentId], references: [id])
  studentId      String           @map("student_id") @db.Uuid
  student        User             @relation("StudentSubmissions", fields: [studentId], references: [id])
  attemptNumber  Int              @map("attempt_number")
  essayText      String           @map("essay_text") @db.Text
  wordCount      Int              @map("word_count")
  status         SubmissionStatus @default(submitted)
  idempotencyKey String?          @map("idempotency_key")
  abuseReason    String?          @map("abuse_reason")
  abuseDetails   Json?            @map("abuse_details") @db.JsonB
  submittedAt    DateTime         @default(now()) @map("submitted_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  scoringResults   ScoringResult[]
  scoreRevisions   ScoreRevision[]
  publishedResults PublishedResult[]
  redoRequests     RedoRequest[]

  @@unique([assignmentId, studentId, attemptNumber])
  @@index([assignmentId], map: "submissions_assignment_id_index")
  @@index([studentId], map: "submissions_student_id_index")
  @@index([status], map: "submissions_status_index")
  @@index([submittedAt], map: "submissions_submitted_at_index")
  @@map("submissions")
}

model AiModelVersion {
  id            String      @id @default(uuid()) @db.Uuid
  modelName     String      @map("model_name") @db.VarChar(100)
  modelVersion  String      @map("model_version") @db.VarChar(100)
  provider      String      @db.VarChar(50)
  taskType      String      @map("task_type") @db.VarChar(20)
  configuration Json        @db.JsonB
  status        ModelStatus @default(active)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  scoringResults ScoringResult[]

  @@unique([modelName, modelVersion])
  @@map("ai_model_versions")
}

model ScoringResult {
  id                 String          @id @default(uuid()) @db.Uuid
  submissionId       String          @map("submission_id") @db.Uuid
  submission         Submission      @relation(fields: [submissionId], references: [id])
  scorerId           String?         @map("scorer_id") @db.Uuid
  scorer             User?           @relation("TeacherScoringResults", fields: [scorerId], references: [id])
  modelVersionId     String?         @map("model_version_id") @db.Uuid
  modelVersion       AiModelVersion? @relation(fields: [modelVersionId], references: [id])
  scorerType         ScorerType      @map("scorer_type")
  status             ScoringStatus   @default(completed)
  scores             Json            @db.JsonB
  feedback           Json            @db.JsonB
  rawOutput          Json?           @map("raw_output") @db.JsonB
  processingMetadata Json?           @map("processing_metadata") @db.JsonB
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  scoreRevisions ScoreRevision[]

  @@index([submissionId], map: "scoring_results_submission_id_index")
  @@index([scorerId], map: "scoring_results_scorer_id_index")
  @@index([modelVersionId], map: "scoring_results_model_version_id_index")
  @@index([createdAt], map: "scoring_results_created_at_index")
  @@map("scoring_results")
}

model ScoreRevision {
  id             String         @id @default(uuid()) @db.Uuid
  submissionId   String         @map("submission_id") @db.Uuid
  submission     Submission     @relation(fields: [submissionId], references: [id])
  /// Null when the teacher graded before the machine did, or after it failed.
  baseResultId   String?        @map("base_result_id") @db.Uuid
  baseResult     ScoringResult? @relation(fields: [baseResultId], references: [id])
  revisedBy      String         @map("revised_by") @db.Uuid
  revisedByUser  User           @relation("TeacherScoreRevisions", fields: [revisedBy], references: [id])
  revisionNumber Int            @map("revision_number")
  changes        Json           @db.JsonB
  finalScores    Json           @map("final_scores") @db.JsonB
  finalFeedback  Json           @map("final_feedback") @db.JsonB
  revisionNote   String?        @map("revision_note") @db.Text
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  publishedResults PublishedResult[]
  reasonTags       RevisionReasonTag[]

  @@unique([submissionId, revisionNumber])
  @@index([submissionId], map: "score_revisions_submission_id_index")
  @@index([revisedBy], map: "score_revisions_revised_by_index")
  @@index([baseResultId], map: "score_revisions_base_result_id_index")
  @@map("score_revisions")
}

model PublishedResult {
  id            String        @id @default(uuid()) @db.Uuid
  submissionId  String        @map("submission_id") @db.Uuid
  submission    Submission    @relation(fields: [submissionId], references: [id])
  revisionId    String        @map("revision_id") @db.Uuid
  revision      ScoreRevision @relation(fields: [revisionId], references: [id])
  publishedBy   String        @map("published_by") @db.Uuid
  publishedUser User          @relation("TeacherPublishedResults", fields: [publishedBy], references: [id])
  finalScores   Json          @map("final_scores") @db.JsonB
  finalFeedback Json          @map("final_feedback") @db.JsonB
  publishedAt   DateTime      @default(now()) @map("published_at") @db.Timestamptz(6)
  unpublishedAt DateTime?     @map("unpublished_at") @db.Timestamptz(6)

  @@index([submissionId], map: "published_results_submission_id_index")
  @@index([publishedBy], map: "published_results_published_by_index")
  @@index([publishedAt], map: "published_results_published_at_index")
  @@map("published_results")
}

/// A teacher's group of students. Assignments may be given to one class.
model Class {
  id          String      @id @default(uuid()) @db.Uuid
  teacherId   String      @map("teacher_id") @db.Uuid
  teacher     User        @relation("TeacherClasses", fields: [teacherId], references: [id])
  name        String      @db.VarChar(160)
  description String?     @db.Text
  status      ClassStatus @default(active)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?   @map("deleted_at") @db.Timestamptz(6)

  members     ClassMember[]
  assignments Assignment[]
  inviteLinks InviteLink[]

  @@index([teacherId], map: "classes_teacher_id_index")
  @@index([status], map: "classes_status_index")
  @@map("classes")
}

/// Roster row. Removal is recorded, never deleted.
model ClassMember {
  id        String    @id @default(uuid()) @db.Uuid
  classId   String    @map("class_id") @db.Uuid
  class     Class     @relation(fields: [classId], references: [id])
  studentId String    @map("student_id") @db.Uuid
  student   User      @relation("StudentClassMemberships", fields: [studentId], references: [id])
  joinedAt  DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)

  @@unique([classId, studentId])
  @@index([classId], map: "class_members_class_id_index")
  @@index([studentId], map: "class_members_student_id_index")
  @@map("class_members")
}

/// A shareable join link for one class.
model InviteLink {
  id        String    @id @default(uuid()) @db.Uuid
  classId   String    @map("class_id") @db.Uuid
  class     Class     @relation(fields: [classId], references: [id])
  teacherId String    @map("teacher_id") @db.Uuid
  teacher   User      @relation("TeacherInviteLinks", fields: [teacherId], references: [id])
  token     String    @unique @db.VarChar(64)
  label     String?   @db.VarChar(160)
  maxUses   Int?      @map("max_uses")
  useCount  Int       @default(0) @map("use_count")
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([classId], map: "invite_links_class_id_index")
  @@index([token], map: "invite_links_token_index")
  @@map("invite_links")
}

/// The teacher asking a student to write the essay again.
model RedoRequest {
  id           String     @id @default(uuid()) @db.Uuid
  submissionId String     @map("submission_id") @db.Uuid
  submission   Submission @relation(fields: [submissionId], references: [id])
  teacherId    String     @map("teacher_id") @db.Uuid
  teacher      User       @relation("TeacherRedoRequests", fields: [teacherId], references: [id])
  reason       String     @db.Text
  status       RedoStatus @default(open)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt   DateTime?  @map("resolved_at") @db.Timestamptz(6)

  @@index([submissionId], map: "redo_requests_submission_id_index")
  @@index([status], map: "redo_requests_status_index")
  @@map("redo_requests")
}

/// Why a revision changed the AI's score. Append-only and separate from
/// score_revisions, because reasons usually arrive after the revision exists
/// and a revision row is never rewritten.
model RevisionReasonTag {
  id           String           @id @default(uuid()) @db.Uuid
  revisionId   String           @map("revision_id") @db.Uuid
  revision     ScoreRevision    @relation(fields: [revisionId], references: [id])
  reasonCodes  RevisionReason[] @map("reason_codes")
  source       ReasonSource
  /// Shared by every tag applied in one batch, so retrospective tagging is visible.
  batchId      String?          @map("batch_id") @db.Uuid
  note         String?          @db.Text
  taggedBy     String           @map("tagged_by") @db.Uuid
  taggedByUser User             @relation("TeacherReasonTags", fields: [taggedBy], references: [id])
  taggedAt     DateTime         @default(now()) @map("tagged_at") @db.Timestamptz(6)

  @@index([revisionId], map: "revision_reason_tags_revision_id_index")
  @@index([batchId], map: "revision_reason_tags_batch_id_index")
  @@map("revision_reason_tags")
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actor      User?    @relation("ActorAuditEvents", fields: [actorId], references: [id])
  eventType  String   @map("event_type") @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id") @db.Uuid
  metadata   Json?    @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorId], map: "audit_events_actor_id_index")
  @@index([entityType, entityId], map: "audit_events_entity_index")
  @@index([eventType], map: "audit_events_event_type_index")
  @@index([createdAt], map: "audit_events_created_at_index")
  @@map("audit_events")
}
