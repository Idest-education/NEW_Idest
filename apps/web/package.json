    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "dotenv-cli": "^11.0.0",
    "eslint": "10.9.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  }
